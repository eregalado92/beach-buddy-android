# Firebase (public web config)
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:0000000000:web:xxxxxxxxxxxx

# Optional: OpenUV (fallback UV)
EXPO_PUBLIC_OPENUV_API_KEY=

# App
EXPO_PUBLIC_USER_AGENT=BeachBuddy/0.1 (contact@example.com)
EXPO_PUBLIC_CACHE_TTL_MIN=45
